#!/usr/bin/env python3
import json
import os
from pathlib import Path
import sys
import time

if not os.environ.get('FAKE_CLI_DIR'):
    sys.exit(97)
root = Path(os.environ['FAKE_CLI_DIR'])
root.mkdir(parents=True, exist_ok=True)
args = sys.argv[1:]
is_help = '--help' in args or '--version' in args or 'status' in args
stdin = '' if is_help or 'queue' in args else sys.stdin.read()
with (root/'calls.jsonl').open('a') as f:
    f.write(json.dumps({'argv':args, 'program':Path(sys.argv[0]).name, 'stdin':stdin, 'cwd':os.getcwd(), ('had_api' + '_key'):any(k in os.environ for k in ('ANTHROPIC_API_KEY','ANTHROPIC_AUTH_TOKEN','OPENAI_API_KEY','CODEX_API_KEY')), 'active':os.environ.get('SIDECARWATCH_ACTIVE')})+'\n')
if '--help' in args:
    if (root/'no-mode').exists():
        print('example CLI')
    elif (root/'old-help').exists():
        print('--print -p --output-format exec -o -s --color -C')
    else:
        print('auth login status --output-format -s --color -C -o --print -p --resume --no-session-persistence --json-schema --tools --system-prompt exec --ephemeral --output-schema --skip-git-repo-check queue --thread --message')
elif 'status' in args:
    if (root/'logged-out').exists():
        print(json.dumps({'loggedIn': False}))
        sys.exit(1)
    print(json.dumps({'loggedIn': True}))
elif '--version' in args:
    print('0.0.0 (fake)')
else:
    if (root/'sleep').exists():
        time.sleep(float((root/'sleep').read_text()))
    status = int((root/'exit-code').read_text()) if (root/'exit-code').exists() else 0
    if (root/'stderr').exists():
        print((root/'stderr').read_text(), file=sys.stderr)
    if status or 'queue' in args or '--resume' in args:
        sys.exit(status)
    if (root/'bad-output').exists():
        print('bad output')
        sys.exit(0)
    value = json.loads((root/'verdict.json').read_text())
    if 'exec' in args:
        Path(args[args.index('-o')+1]).write_text(json.dumps(value))
    else:
        print(json.dumps({'is_error':(root/'is-error').exists(), 'result':json.dumps(value) if (root/'fallback').exists() else '', 'structured_output':None if (root/'fallback').exists() else value}))
